PUBLIC_AGENT_ENVIRONMENT=development
PUBLIC_AGENT_DATABASE_URL=postgresql+asyncpg://public_agent:public_agent@localhost:55432/public_agent
PUBLIC_AGENT_REDIS_URL=redis://localhost:56379/0
PUBLIC_AGENT_POSTGRES_HOST_PORT=55432
PUBLIC_AGENT_REDIS_HOST_PORT=56379
PUBLIC_AGENT_LOG_LEVEL=INFO
PUBLIC_AGENT_SECRET_KEY=replace-with-a-secret-manager-value
PUBLIC_AGENT_API_TOKEN_PEPPER=replace-with-an-independent-secret-manager-value
# PUBLIC_AGENT_SECRETS_DIR=/run/secrets
PUBLIC_AGENT_DEFAULT_MAX_STEPS=12
PUBLIC_AGENT_OPENAI_API_KEY=
